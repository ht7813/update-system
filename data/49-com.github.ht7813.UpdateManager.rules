// /usr/share/polkit-1/rules.d/com.github.ht7813.UpdateManager.rules
//
// 授权模型：
//   - 管理员（wheel 组）在本地活动会话：AUTH_SELF_KEEP
//   - 普通用户在本地活动会话：AUTH_ADMIN_KEEP
//   - 非活动会话或远程会话：AUTH_ADMIN
//   - install-security 对管理员放宽到 AUTH_SELF_KEEP（同上），
//     对普通用户保持 AUTH_ADMIN_KEEP
//
// 注意：本规则不返回 YES，任何情况下都需要认证。

polkit.addRule(function(action, subject) {

    // 只处理我们自己的 action
    if (action.id.indexOf("com.github.ht7813.UpdateManager.") !== 0) {
        return polkit.Result.NOT_HANDLED;
    }

    var isAdmin = subject.isInGroup("wheel");
    var isLocalActive = subject.local && subject.active;

    // ---- 远程或非活动会话：一律要求管理员认证 ----
    if (!isLocalActive) {
        return polkit.Result.AUTH_ADMIN;
    }

    // ---- 本地活动会话 ----
    // 管理员装普通更新：输自己的密码
    if (action.id === "com.github.ht7813.UpdateManager.install") {
        return isAdmin
        ? polkit.Result.AUTH_SELF_KEEP
        : polkit.Result.AUTH_ADMIN_KEEP;
    }

    // 安全更新：管理员 AUTH_SELF_KEEP，普通用户 AUTH_ADMIN_KEEP
    // 这里和普通更新一致，保留分支是为了将来能单独放宽
    if (action.id === "com.github.ht7813.UpdateManager.install-security") {
        return isAdmin
        ? polkit.Result.AUTH_SELF_KEEP
        : polkit.Result.AUTH_ADMIN_KEEP;
    }

    // 其他 action（check / refresh）交给 .policy 文件的默认值处理
    return polkit.Result.NOT_HANDLED;
});
